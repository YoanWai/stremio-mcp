# Stremio account. Everything account-level (library, addon install/uninstall)
# needs one of these; stremio_login can set it for you instead.
# Get it from the web app console at https://web.stremio.com:
#   JSON.parse(localStorage.getItem("profile")).auth.key
STREMIO_AUTH_KEY=

# Android TV target for the adb-based control tools.
ANDROID_TV_HOST=192.168.1.100
ANDROID_TV_PORT=5555
ADB_PATH=adb

# Port the built-in subtitle addon listens on. Any free port works; the
# manifest URL always carries the real one.
STREMIO_MCP_ADDON_PORT=9876

# Where the cached login, subtitle files and addon backups live.
# Defaults to the platform user data directory.
STREMIO_MCP_STATE_DIR=
