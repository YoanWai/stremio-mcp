# Android TV target for adb-based control tools
ANDROID_TV_HOST=192.168.1.100
ANDROID_TV_PORT=5555

# Path to the adb binary (leave as-is if adb is on PATH)
ADB_PATH=adb

# Optional: Stremio account auth key (enables the library tools:
# get/add/remove). Get it at web.stremio.com console:
#   JSON.parse(localStorage.getItem("profile")).auth.key
STREMIO_AUTH_KEY=
